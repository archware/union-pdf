{
  "package": {
    "productName": "union-pdf",
    "version": "0.5.1"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.archware.union-pdf",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "Unión PDF",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../frontend/dist/pdf-tool/browser"
  }
}
