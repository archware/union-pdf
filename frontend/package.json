{
    "name":  "pdf-tool",
    "version":  "1.6.1",
    "scripts":  {
                    "ng":  "ng",
                    "start":  "ng serve --port 1420",
                    "build":  "ng build",
                    "test":  "ng test --watch=false",
                    "test:release":  "node --test --test-concurrency=1 scripts/release-artifacts.test.mjs",
                    "test:admin-recovery":  "node --test scripts/admin-recovery-contract.test.mjs scripts/admin-recovery-release.test.mjs",
                    "check:types":  "tsc -p tsconfig.app.json --noEmit",
                    "check:angular":  "ngc -p tsconfig.app.json",
                    "check:theme":  "node scripts/validate-theme-tokens.js",
                    "check:css":  "node scripts/check-invalid-css-values.js",
                    "check:secrets":  "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/secret_scan.ps1",
                    "check:contracts":  "node scripts/check-hra-contracts.mjs",
                    "check:database-contracts":  "node scripts/check-hra-database-contracts.mjs",
                    "watch":  "ng build --watch --configuration development",
                    "tauri":  "tauri",
                    "desktop:dev":  "scripts\\dev.bat",
                    "desktop:build":  "scripts\\build.bat",
                    "desktop:build:debug":  "scripts\\build_debug.bat",
                    "admin-recovery:build":  "node scripts/admin-recovery-release.mjs build",
                    "admin-recovery:verify-build":  "node scripts/admin-recovery-release.mjs verify-build",
                    "admin-recovery:stage":  "node scripts/admin-recovery-release.mjs stage",
                    "admin-recovery:verify":  "node scripts/admin-recovery-release.mjs verify",
                    "admin-recovery:bundle:prepare":  "node scripts/admin-recovery-bundle-source.mjs --prepare-signed-source",
                    "admin-recovery:bundle:verify":  "node scripts/admin-recovery-bundle-source.mjs --verify-signed-source",
                    "db:validate:sps":  "node scripts/validate-sql-contracts.js",
                    "db:deploy:sps":  "scripts\\db_deploy_sps.bat",
                    "check:atomic":  "node scripts/check-atomic-provenance.mjs",
                    "check:atomic:pin":  "node scripts/check-atomic-pin.mjs",
                    "release:metadata":  "node scripts/release-artifacts.mjs",
                    "release:stage":  "node scripts/stage-windows-release.mjs --policy ci-unsigned",
                    "release:stage:institutional":  "node scripts/stage-windows-release.mjs --policy institutional",
                    "release:verify":  "node scripts/release-artifacts.mjs --verify",
                    "check": "npm run check:atomic && npm run check:types && npm run check:angular && npm run check:theme && npm run check:css && npm run check:secrets && npm test -- --watch=false && npm run build"
                },
    "private":  true,
    "dependencies":  {
                         "@angular/common":  "^22.1.0",
                         "@angular/compiler":  "^22.1.0",
                         "@angular/core":  "^22.1.0",
                         "@angular/forms":  "^22.1.0",
                         "@angular/platform-browser":  "^22.1.0",
                         "@angular/router":  "^22.1.0",
                         "@fontsource/open-sans":  "^5.3.0",
                         "@fortawesome/fontawesome-free":  "^6.7.2",
                         "@ngx-translate/core":  "^17.0.0",
                         "@ngx-translate/http-loader":  "^17.0.0",
                         "@tauri-apps/api":  "^2",
                         "chart.js":  "^4.5.1",
                         "chartjs-plugin-datalabels":  "^2.2.0",
                         "ng2-charts":  "^10.0.0",
                         "rxjs":  "~7.8.2",
                         "tslib":  "^2.8.1",
                         "zone.js":  "~0.15.1"
                     },
    "devDependencies":  {
                            "@angular/build":  "^22.1.2",
                            "@angular/cli":  "^22.1.2",
                            "@angular/compiler-cli":  "^22.1.0",
                            "@tauri-apps/cli":  "^2.11.4",
                            "autoprefixer":  "^10.5.4",
                            "postcss":  "^8.5.23",
                            "tailwindcss":  "^3.4.19",
                            "typescript":  "~6.0.0",
                            "vitest":  "^4.0.8",
                            "jsdom":  "^29.0.0"
                        },
    "overrides":  {
                      "@modelcontextprotocol/sdk":  "1.30.0",
                      "@hono/node-server":  "2.0.12",
                      "tar":  "7.5.22"
                  },
    "atomicRepository":  "../../-Atomic-UI"
}
