# Inventario de variables. La aplicación no carga archivos .env; los valores
# se entregan mediante el entorno del proceso o un gestor institucional.
#
# Opcional para despliegues administrados. Debe ser un hash PHC Argon2id,
# nunca una contraseña en texto plano. Si no existe, el primer inicio crea
# un hash local protegido por Windows Credential Manager.
# Ejemplo de generación:
#   cargo run --example hash_admin_password --manifest-path src-tauri/Cargo.toml
# Variable primaria (se evalúa primero):
HRA_ADMIN_PASSWORD_HASH=
# Variable heredada (fallback sólo si la primaria no existe):
#HRA_TAURI_ADMIN_PASSWORD_HASH=

# Configuración no secreta de SQL Server.
HRA_DB_NAME=indicadores_hra
HRA_DB_PORT=1433

# Opcional: CA PEM adicional para validar un certificado interno.
HRA_SQL_CA_CERT=

# Sólo para desarrollo local con compilación debug. TLS continúa siendo obligatorio,
# pero el certificado no se valida. La aplicación rechaza esta opción en release.
HRA_DEV_ALLOW_INVALID_CERT=false
